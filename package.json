{
  "name": "@codeperfect/commitlint-config-emoji",
  "version": "0.0.0",
  "description": "Emoji-required conventional commitlint shareable config.",
  "license": "MIT",
  "repository": "github:parloti/commitlint-config-emoji",
  "author": "Alex Parloti",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "\n# ---------------- GENERAL  ---------------- #": "",
    "prepare": "patch-package && husky",
    "\n# ------------------ SCM  ------------------ #": "",
    "commit": "npx --yes git-cz",
    "\n# ---------------- BUILDING ---------------- #": "",
    "build": "npm run clean && npm run compile && npm run resolve-paths",
    "clean": "npx --yes rimraf dist",
    "\n    • ---------- compilation  ---------- •": "",
    "pack": "npm pack --pack-destination dist",
    "compile": "tsc --build --force ./tsconfig.build.json",
    "resolve-paths": "npx --yes tsc-alias --project ./tsconfig.build.json --resolve-full-paths",
    "\n# ---------------- LINTING  ---------------- #": "",
    "\n    • ------------ checking ------------ •": "",
    "eslint": "npx --yes eslint --max-warnings=0",
    "lint": "npm run lint:run",
    "lint:run": "npm run prettier && npm run eslint",
    "prettier": "npx --yes prettier --ignore-unknown --check .",
    "\n    • ------------- fixing ------------- •": "",
    "eslint:fix": "npm run check:rules && npm run eslint -- --fix",
    "lint:fix": "npm run fmt && npm run eslint:fix",
    "lint:staged": "npx --yes tsx scripts/lint-staged.ts",
    "fmt": "npm run prettier -- --write",
    "\n    • ------------ helpers  ------------ •": "",
    "check:rules": "npx --yes eslint-config-prettier eslint.config.ts",
    "eslint:inspect": "npx --yes @eslint/config-inspector",
    "\n# ---------------- TESTING  ---------------- #": "",
    "e2e": "npx --yes vitest run --config vitest.config.e2e.ts",
    "mutation": "npx --yes stryker run",
    "test:all": "npm run test && npm run e2e && npm run mutation",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run build --if-present && npm run test:all && npm run pack --if-present",
    "\n    • -------------- unit -------------- •": "",
    "test": "npx --yes vitest run",
    "tdd": "npm run test -- --watch --silent=true --coverage.enabled=false"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "commitlint",
    "conventional-commits",
    "emoji"
  ],
  "devDependencies": {
    "@codeperfect/commitlint-config-emoji": "^1.0.0",
    "@codeperfect/eslint-config": "^1.15.0",
    "@codeperfect/eslint-plugin": "^2.7.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "chalk": "^6.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "lodash-es": "^4.18.1",
    "patch-package": "^8.0.1",
    "semantic-release": "^25.0.9",
    "tsc-alias": "^1.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@commitlint/types": "^21.2.0"
  }
}
